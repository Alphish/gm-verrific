/// @desc A test item (a test suite or a test case).
/// @arg {String} title     The title of the test item.
function VerrificTestItem(_title) constructor {
    /// @desc Indicates whether the test item is a suite or not.
    static is_suite = false;
    
    /// @desc The title of the test item.
    /// @returns {String}
    title = _title
}
